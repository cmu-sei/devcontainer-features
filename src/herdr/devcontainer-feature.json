{
    "id": "herdr",
    "version": "1.1.0",
    "name": "Herdr",
    "description": "Installs the Herdr terminal workspace manager via the official installer script",
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "postCreateCommand": "bash -l /usr/local/share/org-features/herdr/postcreate.sh",
    "postStartCommand": "bash -l /usr/local/share/org-features/herdr/poststart.sh"
}
