{
  "disabled_providers": ["opencode"],
  "provider": {
    "amazon-govcloud": {
      "npm": "@ai-sdk/amazon-bedrock",
      "name": "Amazon Bedrock (GovCloud)",
      "options": {
        "region": "us-gov-east-1"
      },
      "models": {
        "claude-fable-5.1": {
          "id": "us-gov.anthropic.claude-fable-5-1",
          "name": "Claude Fable 5.1"
        },
        "claude-opus-5.5": {
          "id": "us-gov.anthropic.claude-opus-5-5",
          "name": "Claude Opus 5.5",
          "family": "claude-opus",
          "reasoning": true,
          "attachment": true,
          "temperature": false,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "cost": {
            "input": 4.4,
            "output": 22,
            "cache_read": 0.22,
            "cache_write": 5.5
          }
        },
        "claude-sonnet-5": {
          "id": "us-gov.anthropic.claude-sonnet-5",
          "name": "Claude Sonnet 5"
        },
        "grok-4.6": {
          "id": "xai.grok-4.6",
          "name": "Grok 4.6",
          "limit": {
            "context": 500000,
            "output": 500000
          },
          "provider": {
            "npm": "@ai-sdk/amazon-bedrock/mantle",
            "api": "https://bedrock-mantle.us-gov-east-1.api.aws/openai/v1",
            "shape": "responses"
          }
        }
      }
    },
    "amazon-bedrock": {
      "blacklist": ["openai.gpt-5.4"],
      "options": {
        "region": "us-gov-west-1",
        "baseURL": "https://bedrock-mantle.us-gov-west-1.api.aws/openai/v1"
      }
    }
  }
}
